      <column caption='Age Bins' datatype='string' name='[Calculation_1179805011664896]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &gt;= 60 THEN &apos;60+&apos;&#13;&#10;ELSEIF [age] &gt;= 50 THEN &apos;50s&apos;&#13;&#10;ELSEIF [age] &gt;= 40 THEN &apos;40s&apos;&#13;&#10;ELSEIF [age] &gt;= 30 THEN &apos;30s&apos;&#13;&#10;ELSEIF [age] &gt;= 20 THEN &apos;20s&apos;&#13;&#10;ELSE &apos;Under 20&apos;&#13;&#10;END' />
      </column>
      <column caption='Screen Time Hours Per Week' datatype='real' name='[Calculation_1179806789935106]' role='measure' type='quantitative'>
